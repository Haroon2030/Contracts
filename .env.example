# تطوير محلي
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SSL_REDIRECT=0
DJANGO_COOKIE_SECURE=0
DJANGO_SETTINGS_MODULE=cms.settings

